# ===========================================
# NexaPay — Environment Variables (ALL SERVICES)
# ===========================================

# --- GLOBAL ---
NODE_ENV=development
LOG_LEVEL=debug
TZ=UTC

# --- API GATEWAY ---
API_GATEWAY_PORT=3000
API_GATEWAY_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:8100

# --- AUTH SERVICE ---
AUTH_SERVICE_PORT=4001
AUTH_SERVICE_GRPC_PORT=50051
AUTH_DATABASE_URL=postgresql://nexapay:nexapay_pass@localhost:5432/nexapay_auth
AUTH_REDIS_URL=redis://localhost:6379/0
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=nexapay-auth
TOTP_ISSUER=NexaPay
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=

# --- USER & KYC SERVICE ---
USER_SERVICE_PORT=4002
USER_DATABASE_URL=postgresql://nexapay:nexapay_pass@localhost:5432/nexapay_users
USER_MONGO_URL=mongodb://localhost:27017/nexapay_kyc
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_KYC=nexapay-kyc-documents
AWS_S3_BUCKET_AVATAR=nexapay-user-avatars
AWS_CLOUDFRONT_URL=https://d123.cloudfront.net

# --- WALLET SERVICE ---
WALLET_SERVICE_PORT=4003
WALLET_SERVICE_GRPC_PORT=50052
WALLET_DATABASE_URL=postgresql://nexapay:nexapay_pass@localhost:5432/nexapay_wallets
WALLET_REDIS_URL=redis://localhost:6379/1
WALLET_CACHE_TTL=300

# --- LOAN SERVICE ---
LOAN_SERVICE_PORT=4004
LOAN_DATABASE_URL=postgresql://nexapay:nexapay_pass@localhost:5432/nexapay_loans
LOAN_REDIS_URL=redis://localhost:6379/2

# --- INVESTMENT SERVICE ---
INVESTMENT_SERVICE_PORT=4005
INVESTMENT_MONGO_URL=mongodb://localhost:27017/nexapay_investments
INVESTMENT_REDIS_URL=redis://localhost:6379/3

# --- NOTIFICATION SERVICE ---
NOTIFICATION_SERVICE_PORT=4006
NOTIFICATION_MONGO_URL=mongodb://localhost:27017/nexapay_notifications
NOTIFICATION_REDIS_URL=redis://localhost:6379/4
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+1234567890
FCM_SERVER_KEY=
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=

# --- REPORTING SERVICE ---
REPORTING_SERVICE_PORT=4007
REPORTING_MYSQL_URL=mysql://nexapay:nexapay_pass@localhost:3306/nexapay_reporting
ELASTICSEARCH_URL=http://localhost:9200

# --- FRAUD DETECTION SERVICE ---
FRAUD_SERVICE_PORT=4008
FRAUD_REDIS_URL=redis://localhost:6379/5
FRAUD_RATE_LIMIT_WINDOW_MS=60000
FRAUD_RATE_LIMIT_MAX=100

# --- KAFKA ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=nexapay
KAFKA_CONSUMER_GROUP_PREFIX=nexapay-

# --- DATABASES ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nexapay
POSTGRES_PASSWORD=nexapay_pass
POSTGRES_DB=nexapay

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=nexapay
MYSQL_PASSWORD=nexapay_pass
MYSQL_DB=nexapay_reporting

MONGO_URI=mongodb://localhost:27017/nexapay

REDIS_HOST=localhost
REDIS_PORT=6379

# --- ELASTICSEARCH ---
ELASTICSEARCH_NODE=http://localhost:9200

# --- PROMETHEUS ---
PROMETHEUS_PUSH_GATEWAY=http://localhost:9091

# --- ENCRYPTION ---
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_ALGORITHM=aes-256-gcm

# --- IDEMPOTENCY ---
IDEMPOTENCY_TTL=86400

# --- RATE LIMITING ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- SENTRY (optional) ---
SENTRY_DSN=
