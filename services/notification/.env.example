# ──────────────────────────────────────────────
# NexaPay Notification Service — Environment
# ──────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3004

# MongoDB
MONGODB_URI=mongodb://localhost:27017/nexapay_notification

# Redis (deduplication + rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=nexapay-notification
KAFKA_GROUP_ID=notification-group

# SendGrid (Email)
SENDGRID_API_KEY=sg_your_api_key_here
EMAIL_FROM=noreply@nexapay.com

# SMTP Fallback (Nodemailer)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=sg_your_api_key_here

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Firebase Cloud Messaging (Push)
FCM_TYPE=service_account
FCM_PROJECT_ID=nexapay-xxxxx
FCM_PRIVATE_KEY_ID=your_private_key_id
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FCM_CLIENT_EMAIL=firebase-adminsdk@nexapay.iam.gserviceaccount.com
FCM_CLIENT_ID=your_client_id
FCM_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FCM_TOKEN_URI=https://oauth2.googleapis.com/token
FCM_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FCM_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/...

# Rate Limit (notifications per user per hour)
NOTIFICATION_RATE_LIMIT=50

# WebSocket
WS_PATH=/notifications
