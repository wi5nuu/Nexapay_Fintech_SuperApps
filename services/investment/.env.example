# ─── Server ─────────────────────────────────────────────────
PORT=3002
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ─── Database (PostgreSQL via Prisma) ───────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexapay_investments

# ─── MongoDB (Mongoose — Investment Documents & Price Feed) ─
MONGODB_URI=mongodb://localhost:27017/nexapay-investments

# ─── Redis (Pub/Sub for real-time price feed) ───────────────
REDIS_URI=redis://localhost:6379

# ─── Kafka (Event Bus) ──────────────────────────────────────
KAFKA_BROKERS=localhost:9092
