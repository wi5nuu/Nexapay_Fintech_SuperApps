NODE_ENV=development
LOG_LEVEL=debug
TZ=UTC

# --- Service ---
REPORTING_SERVICE_PORT=4007

# --- MySQL ---
REPORTING_MYSQL_URL=mysql://nexapay:nexapay_pass@localhost:3306/nexapay_reporting

# --- Elasticsearch ---
ELASTICSEARCH_NODE=http://localhost:9200

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8100
