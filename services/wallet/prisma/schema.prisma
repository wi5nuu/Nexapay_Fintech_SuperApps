generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  TOP_UP
  TRANSFER
  WITHDRAWAL
  PAYMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String
  currency  String   @default("USD")
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sentTransactions     Transaction @relation("SentTransactions")
  receivedTransactions Transaction @relation("ReceivedTransactions")

  @@unique([userId, currency])
  @@index([userId])
  @@map("wallets")
}

model Transaction {
  id              String            @id @default(uuid())
  idempotencyKey  String            @unique
  fromWalletId    String?
  toWalletId      String?
  amount          Decimal           @db.Decimal(18, 2)
  currency        String
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  description     String?
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  fromWallet Wallet? @relation("SentTransactions", fields: [fromWalletId], references: [id])
  toWallet   Wallet? @relation("ReceivedTransactions", fields: [toWalletId], references: [id])

  @@index([fromWalletId])
  @@index([toWalletId])
  @@index([idempotencyKey])
  @@index([createdAt])
  @@map("transactions")
}

model BalanceAuditLog {
  id          String   @id @default(uuid())
  walletId    String
  previousBalance Decimal @db.Decimal(18, 2)
  newBalance      Decimal @db.Decimal(18, 2)
  changeAmount    Decimal @db.Decimal(18, 2)
  transactionId  String?
  operation  String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([walletId])
  @@index([createdAt])
  @@map("balance_audit_logs")
}
