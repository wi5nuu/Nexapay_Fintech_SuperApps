# Server
HTTP_PORT=3000
GRPC_PORT=50051
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://nexapay:changeme@localhost:5432/nexapay_wallet?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=localhost:9092

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:5173

# Throttle (requests per minute per IP)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
