# Server
HTTP_PORT=3000
GRPC_URL=0.0.0.0:50051
GRPC_PROTO_PATH=./proto/user-kyc.proto

# Database (PostgreSQL via Prisma)
DATABASE_URL=postgresql://nexapay:nexapay@localhost:5432/nexapay_user_kyc

# MongoDB (KYC document storage)
MONGODB_URI=mongodb://localhost:27017/nexapay-kyc

# AWS S3 (Avatar uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_AVATAR_BUCKET=nexapay-avatars

# Kafka
KAFKA_BROKER=localhost:9092

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=*
