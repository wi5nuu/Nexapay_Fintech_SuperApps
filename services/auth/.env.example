# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexapay_auth

# JWT
JWT_SECRET=change-this-to-a-very-long-random-string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=nexapay-auth

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=auth:

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# CORS
CORS_WHITELIST=http://localhost:3000,http://localhost:4200

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=20

# gRPC
GRPC_PORT=50051

# Encryption
ENCRYPTION_KEY=change-this-to-a-32-byte-hex-string
