# ===========================================
# NexaPay — API Gateway Environment Variables
# ===========================================

# Server
PORT=4000
GRAPHQL_PORT=4001
NODE_ENV=development
LOG_LEVEL=debug

# CORS
CORS_ORIGINS=http://localhost:4200,http://localhost:8100,http://localhost:5173

# Rate Limiting
RATE_LIMIT_MAX=200
GRAPHQL_RATE_LIMIT=100

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ISSUER=nexapay-auth

# --- Microservice URLs (Docker Compose service names) ---
AUTH_SERVICE_URL=http://auth:4001
USER_KYC_SERVICE_URL=http://user-kyc:4002
WALLET_SERVICE_URL=http://wallet:4003
LOAN_SERVICE_URL=http://loan:4004
INVESTMENT_SERVICE_URL=http://investment:4005
NOTIFICATION_SERVICE_URL=http://notification:4006
REPORTING_SERVICE_URL=http://reporting:4007
FRAUD_SERVICE_URL=http://fraud-detection:4008

# --- GraphQL Subgraph URLs ---
AUTH_SUBGRAPH_URL=http://auth:4001/graphql
USER_KYC_SUBGRAPH_URL=http://user-kyc:4002/graphql
WALLET_SUBGRAPH_URL=http://wallet:4003/graphql
LOAN_SUBGRAPH_URL=http://loan:4004/graphql
INVESTMENT_SUBGRAPH_URL=http://investment:4005/graphql
NOTIFICATION_SUBGRAPH_URL=http://notification:4006/graphql
REPORTING_SUBGRAPH_URL=http://reporting:4007/graphql
FRAUD_SUBGRAPH_URL=http://fraud-detection:4008/graphql

# Subgraph Polling Interval (ms)
SUBGRAPH_POLL_INTERVAL=10000

# Apollo Studio (managed federation) - leave empty for local/dev
APOLLO_GRAPH_REF=
APOLLO_KEY=
